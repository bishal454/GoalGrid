# =============================================================================
# GoalGrid Environment Configuration
# =============================================================================
# Copy this file to .env in the project root AND in /backend/.env
# The backend loads .env from its own directory (backend/.env)
# =============================================================================

# --- API Keys ---

# Google Gemini / Vertex AI (for RAG, AI analysis, agent chat)
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative: Google Cloud Vertex AI project credentials
GCP_PROJECT=your-gcp-project-id-here
GCP_LOCATION=us-central1

# Football Data API (live scores, match data, standings)
FOOTBALL_DATA_API_KEY=your-football-data-api-key-here

# Ticketmaster Discovery API (ticket search)
TICKETMASTER_API_KEY=your-ticketmaster-api-key-here

# OpenWeather / Weather API (forecast data)
OPENWEATHER_API_KEY=your-openweather-api-key-here
# OR alternative weather API key
WEATHER_API_KEY=your-weather-api-key-here

# OpenStreetMap Overpass API (hotel discovery, nearby places)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Database ---

# MongoDB Atlas connection string
# Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGODB_DB_NAME=offside_ai

# --- Frontend ---

# Backend API URL (frontend connects to this)
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- App Mode ---

# Set to "club" for club football or "fifa" for FIFA World Cup mode
APP_MODE=club

# --- Old/Harmless Variables (kept for compatibility, leave empty) ---

# Hotelbeds/LiteAPI (replaced by OpenStreetMap - leave empty)
HBX_API_KEY=
HBX_SECRET=
HBX_ENV=test
LITEAPI_KEY=

# Google Maps (replaced by Leaflet/OpenStreetMap - leave empty)
GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=
